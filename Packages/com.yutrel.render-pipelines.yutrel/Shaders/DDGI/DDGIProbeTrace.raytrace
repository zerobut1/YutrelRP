#pragma max_recursion_depth 1

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "DDGICommon.hlsl"
#define YUTREL_DDGI_PROBE_TRACE_RADIANCE_COMMON
#include "DDGIProbeTraceCommon.hlsl"

RWTexture2DArray<float2> _DDGIProbeRayData;

[shader("miss")]
void Miss(inout DDGIProbeTracePayload payload : SV_RayPayload)
{
    DDGITraceMiss(payload);
}

[shader("raygeneration")]
void RayGenDDGIProbeTrace()
{
    uint3 id           = DispatchRaysIndex();
    uint3 dim          = DispatchRaysDimensions();
    int3 probeCoords   = DDGIProbeCoordsFromPlaneIndex((int)id.y, (int)id.z);
    uint3 outputCoords = uint3(id.x, id.y, id.z);
    uint rayCount      = max(dim.x, 1u);

    if (_DDGIProbeClassificationEnabled != 0 &&
        DDGILoadProbeState(_DDGIProbeData, probeCoords) == DDGI_PROBE_STATE_INACTIVE &&
        !DDGIIsFixedRay(id.x, rayCount))
    {
        return;
    }

    RayDesc ray;
    ray.Origin    = DDGIProbeWorldPosition(_DDGIProbeData, probeCoords);
    ray.TMin      = 0.0f;
    ray.Direction = DDGIGetProbeRayDirection(id.x, rayCount);
    ray.TMax      = _DDGIProbeMaxRayDistance;

    DDGIProbeTracePayload payload;
    DDGITraceInitPayload(payload);

    TraceRay(
        _DDGIAccelerationStructure,
        RAY_FLAG_NONE,
        DDGI_RAY_MASK,
        0,
        1,
        0,
        ray,
        payload);

    if (payload.hitKind == DDGI_TRACE_HIT_KIND_MISS)
    {
        float3 radiance = DDGITraceEnvironmentRadiance(ray.Direction);
        _DDGIProbeRayData[outputCoords] = DDGIEncodeProbeRayMiss(saturate(radiance));
        return;
    }

    if (payload.hitKind != DDGI_TRACE_HIT_KIND_FRONT_FACE)
    {
        _DDGIProbeRayData[outputCoords] = DDGIEncodeProbeRayBackface(payload.rayT);
        return;
    }

    if (DDGIIsFixedRay(id.x, rayCount))
    {
        _DDGIProbeRayData[outputCoords] =
            DDGIEncodeProbeRayFrontface(float3(0.0f, 0.0f, 0.0f), payload.rayT);
        return;
    }

    float3 radiance = DDGITraceEvaluateRadiance(payload, ray.Direction);
    _DDGIProbeRayData[outputCoords] = DDGIEncodeProbeRayFrontface(radiance, payload.rayT);
}
